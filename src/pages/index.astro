---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Projects from '../components/sections/Projects.astro';
import CTA from '../components/sections/CTA.astro';
import { siteSettings } from '../lib/site-settings';
import { getEntry } from 'astro:content';

const homePage = await getEntry('pages', 'home');
const homeData = homePage?.data;
const homeTitle = homeData?.heroTitle || 'Power Your Future with Clean Energy';
const homeSubtitle = homeData?.heroSubtitle || siteSettings.siteDescription;
const homeCta = homeData?.heroCTA || 'Get Free Quote';
const { Content: HomeContent } = homePage ? await homePage.render() : { Content: null };
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteSettings.companyName,
  description: siteSettings.siteDescription,
  url: siteSettings.siteUrl,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: siteSettings.phone,
    email: siteSettings.email,
    contactType: 'Customer Service',
  },
  sameAs: Object.values(siteSettings.social).filter(Boolean),
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteSettings.address,
  },
};
---

<BaseLayout
  title={homeData?.title || 'Home'}
  description={homeSubtitle}
>
  <JsonLd schema={schema} />
  
  <Hero title={homeTitle} subtitle={homeSubtitle} ctaText={homeCta} />
  {HomeContent && (
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4 max-w-4xl prose prose-lg text-gray-600">
        <HomeContent />
      </div>
    </section>
  )}
  <Services />
  <Projects />
  <Testimonials />
  <CTA />
</BaseLayout>
