---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import SolarPanel from '../components/icons/SolarPanel.astro';
import Installation from '../components/icons/Installation.astro';
import Maintenance from '../components/icons/Maintenance.astro';
import Consulting from '../components/icons/Consulting.astro';
import Battery from '../components/icons/Battery.astro';
import LeafEnergy from '../components/icons/LeafEnergy.astro';
import { getCollection } from 'astro:content';
import { fallbackServices } from '../lib/content-fallbacks';
import { siteSettings } from '../lib/site-settings';

const base = import.meta.env.BASE_URL;
const entries = await getCollection('services');
const services = entries.length
  ? await Promise.all(entries.map(async (entry) => ({ ...entry.data, slug: entry.slug, Content: (await entry.render()).Content })))
  : fallbackServices.map((service) => ({ ...service, slug: '', Content: null }));
services.sort((a, b) => a.order - b.order);
const icons = { SolarPanel, Battery, Installation, Maintenance, Consulting, LeafEnergy };
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Solar Energy Installation',
  provider: { '@type': 'Organization', name: siteSettings.companyName, url: siteSettings.siteUrl },
  description: siteSettings.siteDescription,
};
---

<BaseLayout title="Services" description={siteSettings.siteDescription}>
  <JsonLd schema={schema} />
  <section class="relative py-20 bg-gradient-to-br from-primary-50 via-white to-secondary-50">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 animate-fade-in-up">Comprehensive Solar Solutions</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">Explore our services, features, and the benefits each solution offers.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <SectionTitle subtitle="What We Offer" title="Our Services" description="Tailored solar solutions backed by expert installation and ongoing support." />
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
        {services.map((service, index) => {
          const ServiceIcon = icons[service.icon as keyof typeof icons] || SolarPanel;
          return (
            <Card class="animate-on-scroll flex flex-col" style={`animation-delay: ${index * 0.1}s`}>
              <div class="mb-4"><ServiceIcon class="w-16 h-16 text-primary-600" /></div>
              <h2 class="text-2xl font-bold text-gray-900 mb-3">{service.title}</h2>
              <p class="text-gray-600 mb-4">{service.description}</p>
              {service.features?.length > 0 && (
                <div class="mb-4 flex-grow">
                  <h3 class="font-semibold text-gray-900 mb-2">Features</h3>
                  <ul class="space-y-2 list-disc pl-5 text-sm text-gray-600">
                    {service.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                </div>
              )}
              {service.benefits && <p class="mt-4 pt-4 border-t font-semibold text-primary-600">{service.benefits}</p>}
              {service.Content && (
                <details class="mt-4 border-t pt-4">
                  <summary class="cursor-pointer font-semibold text-primary-700">More about this service</summary>
                  <div class="prose prose-sm mt-3 text-gray-600"><service.Content /></div>
                </details>
              )}
            </Card>
          );
        })}
      </div>
      <div class="text-center mt-12"><Button href={`${base}contact`} variant="primary" size="lg">Request a Quote</Button></div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Ready to start your solar journey?</h2>
      <p class="text-gray-600 mb-8">Talk with our team about the right system for your property.</p>
      <Button href={`${base}contact`} variant="secondary" size="lg">Get a Free Consultation</Button>
    </div>
  </section>
</BaseLayout>
