---
import SectionTitle from '../SectionTitle.astro';
import Card from '../Card.astro';
import { getCollection } from 'astro:content';
import { fallbackTestimonials } from '../../lib/content-fallbacks';

const entries = await getCollection('testimonials');
const testimonials = entries.length
  ? entries.map((entry) => entry.data)
  : fallbackTestimonials;
testimonials.sort((a, b) => b.date.getTime() - a.date.getTime());
---

<section id="testimonials" class="py-20 bg-gradient-to-b from-gray-50 to-white">
  <div class="container mx-auto px-4">
    <SectionTitle subtitle="Testimonials" title="What Our Clients Say" description="Feedback from customers who have made the switch to solar." />
    <div class="grid md:grid-cols-3 gap-8 mt-12">
      {testimonials.map((testimonial, index) => (
        <Card class="animate-on-scroll relative" style={`animation-delay: ${index * 0.15}s`}>
          <div class="absolute top-6 right-6 text-primary-200 opacity-50" aria-hidden="true">
            <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          </div>
          <div class="flex gap-1 mb-4" aria-label={`${testimonial.rating} out of 5 stars`}>
            {[...Array(testimonial.rating)].map(() => <span class="text-yellow-400" aria-hidden="true">★</span>)}
          </div>
          <p class="text-gray-600 mb-6 italic">“{testimonial.content}”</p>
          <div class="flex items-center gap-4 pt-4 border-t">
            <div class="text-4xl" aria-hidden="true">{testimonial.avatar || '👤'}</div>
            <div>
              <div class="font-bold text-gray-900">{testimonial.name}</div>
              <div class="text-sm text-gray-500">{testimonial.role}</div>
              <time class="text-xs text-gray-400" datetime={testimonial.date.toISOString()}>{testimonial.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
