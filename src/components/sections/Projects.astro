---
import SectionTitle from '../SectionTitle.astro';
import { getCollection } from 'astro:content';
import { fallbackProjects } from '../../lib/content-fallbacks';

const entries = await getCollection('projects');
const projects = entries.length
  ? await Promise.all(entries.map(async (entry) => ({ ...entry.data, slug: entry.slug, Content: (await entry.render()).Content })))
  : fallbackProjects.map((project) => ({ ...project, image: undefined, Content: null }));
projects.sort((a, b) => b.date.getTime() - a.date.getTime());
---

<section id="projects" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <SectionTitle subtitle="Our Work" title="Featured Projects" description="Explore our portfolio of successful solar installations." />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      {projects.map((project, index) => (
        <article class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-500 animate-on-scroll" style={`animation-delay: ${index * 0.1}s`}>
          <div class="h-64 relative overflow-hidden" style={!project.image ? `background: ${'gradient' in project ? project.gradient : 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)'}` : undefined}>
            {project.image && <img src={project.image} alt={project.title} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />}
            <svg class="absolute inset-0 w-full h-full opacity-20" viewBox="0 0 100 100" aria-hidden="true">
              <defs><pattern id={`grid-${index}`} x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse"><rect width="20" height="20" fill="none" stroke="white" stroke-width="0.5"/></pattern></defs>
              <rect width="100" height="100" fill={`url(#grid-${index})`}/>
            </svg>
            <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-gray-900 px-3 py-1 rounded-full text-sm font-semibold">{project.category}</span>
            <span class="absolute top-4 right-4 bg-primary-600/90 text-white px-3 py-1 rounded-full text-sm font-semibold">{project.capacity}</span>
          </div>
          <div class="bg-white p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">{project.title}</h3>
            <div class="flex items-center text-sm text-gray-500 mb-3">
              <span>{project.location}</span>
              <span class="mx-2" aria-hidden="true">·</span>
              <time datetime={project.date.toISOString()}>{project.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</time>
            </div>
            <p class="text-gray-600 text-sm">{project.description}</p>
            {project.Content && (
              <details class="mt-4 border-t pt-4">
                <summary class="cursor-pointer font-semibold text-primary-700">Project details</summary>
                <div class="prose prose-sm mt-3 text-gray-600"><project.Content /></div>
              </details>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
