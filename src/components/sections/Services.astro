---
import SectionTitle from '../SectionTitle.astro';
import Card from '../Card.astro';
import SolarPanel from '../icons/SolarPanel.astro';
import Installation from '../icons/Installation.astro';
import Maintenance from '../icons/Maintenance.astro';
import Consulting from '../icons/Consulting.astro';
import Battery from '../icons/Battery.astro';
import LeafEnergy from '../icons/LeafEnergy.astro';
import { getCollection } from 'astro:content';
import { fallbackServices } from '../../lib/content-fallbacks';

const base = import.meta.env.BASE_URL;
const serviceEntries = await getCollection('services');
const services = (serviceEntries.length ? serviceEntries.map((entry) => ({ ...entry.data, slug: entry.slug })) : fallbackServices)
  .sort((a, b) => a.order - b.order);
const icons = { SolarPanel, Battery, Installation, Maintenance, Consulting, LeafEnergy };
---

<section id="services" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <SectionTitle
      subtitle="Our Services"
      title="Comprehensive Solar Solutions"
      description="From consultation to installation and maintenance, we provide end-to-end solar energy solutions for homes and businesses."
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      {services.map((service, index) => {
        const ServiceIcon = icons[service.icon as keyof typeof icons] || SolarPanel;
        return (
          <Card class="animate-on-scroll" style={`animation-delay: ${index * 0.1}s`}>
            <div class="mb-4"><ServiceIcon class="w-16 h-16 text-primary-600" /></div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">{service.title}</h3>
            <p class="text-gray-600">{service.description}</p>
            {service.benefits && <p class="mt-4 text-sm font-semibold text-primary-600">{service.benefits}</p>}
            <a href={`${base}services`} class="inline-flex items-center mt-4 text-primary-600 hover:text-primary-700 font-semibold transition-colors">
              Learn More
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </Card>
        );
      })}
    </div>
  </div>
</section>
